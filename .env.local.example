NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI chat assistant (OpenAI). OPENAI_MODEL is optional, defaults to gpt-6-luna.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Pricing constant for AI estimates. Run `npm run calibrate:quote` and paste the suggested values.
SUPABASE_SERVICE_ROLE_KEY=
QUOTE_CONSTANT_STEEL=
QUOTE_CONSTANT_STAINLESS=
QUOTE_CONSTANT=
